# Copy this file to .env and fill in real values. Never commit .env.

# Airflow
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_WEBSERVER_SECRET_KEY=change_this_to_a_random_string

# Postgres instance shared by Airflow metadata + the analytical warehouse
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change_me
POSTGRES_DB=airflow
AQI_DB_NAME=aqi_db

# OpenAQ (https://explore.openaq.org -> sign up for a free API key)
OPENAQ_API_KEY=your_openaq_api_key
OPENAQ_LOCATION_ID=your_openaq_location_id

# Target station used for weather enrichment (Open-Meteo, no key required)
CITY_NAME=Delhi
STATION_LATITUDE=28.6139
STATION_LONGITUDE=77.2090
