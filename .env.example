# ─────────────────────────────────────────────────────────────────────────────
# AQI Pipeline — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=aqi_user
POSTGRES_PASSWORD=aqi_secret_password_change_me
POSTGRES_DB=aqi_db
POSTGRES_HOST=localhost
# Host port of the Docker Postgres (containers always use 5432 internally)
POSTGRES_PORT=5433

# ── Airflow ───────────────────────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=your_fernet_key_here
AIRFLOW_SECRET_KEY=your_secret_key_here

# ── OpenAQ API ────────────────────────────────────────────────────────────────
# Required: the API answers 401 without a valid key. Free at https://explore.openaq.org/
OPENAQ_API_KEY=

# ── Open-Meteo ────────────────────────────────────────────────────────────────
# No API key required — completely free
# See: https://open-meteo.com/

# ── Target Cities ─────────────────────────────────────────────────────────────
# Comma-separated list of cities to ingest
TARGET_CITIES=Delhi,Mumbai,Bengaluru,Chennai,Kolkata

# ── Pipeline Settings ─────────────────────────────────────────────────────────
# Number of historical days to backfill on first run
BACKFILL_DAYS=30
# Max AQI rejection rate before pipeline fails (percentage, 0-100)
MAX_REJECTION_RATE=20
